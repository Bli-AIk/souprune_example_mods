#![enable(implicit_some)]
(
    prototypes: {
        "spear": (
            visual: "spear",
            collider: BoxCollider(3.0, 12.0),
            damage: 2.0,
            lifetime: 4.0,
            z_index: 15.0,
            hit_behavior: Persistent,
        ),
    },

    behaviors: {
        "move_right": Linear((
            dir: (1.0, 0.0),
            speed: 200.0,
        )),
        "fade_in": Tween((
            target: Opacity,
            duration: 2.0,
            ease: QuadOut,
            range: (0.0, 1.0),
            delay: 0.0,
        )),
    },

    timeline: [
        (
            t: 0.0,
            spawn: "spear",
            pattern: EdgeGenerator(count: 5, side: Left, spacing: 35.0, margin: 250.0),
            apply: ["move_right", "fade_in"],
        ),
    ],
)
