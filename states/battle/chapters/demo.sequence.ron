#![enable(implicit_some)]
(
    // Example with FRE rules file
    // 带 FRE 规则文件的示例
    mode: "battle",
    rules_file: "states/battle/rules/demo_battle.fre.ron",
    
    chapters: [
        SetCamera(SetZoom(2.0)),
        SpawnView(view_layout: "states/battle/view/undertale.view.ron"),
        SetPlayer(Spawn(config_path: "states/battle/players/player.battle_player.ron", position: (0.0, 0.0))),
        DanmakuPerformance(
            performance: "states/battle/danmaku/demo_attack.performance.ron",
            position: (0.0, 50.0),
        ),
    ],
)
